/* =====================================================================
   light.qss - Finora light theme

   A Qt style sheet works like CSS on a web page. Each rule picks some
   widgets and sets their colours, spacing and corners.
     QLabel#pageTitle  means: the QLabel whose objectName is "pageTitle".
   Colours are hex codes. #16A34A is Finora green.
   ===================================================================== */

/* ---- Window background ---- */
QMainWindow,
QStackedWidget#pageStack {
    background-color: #F5F7FA;
}

/* ---- Sidebar ---- */
QFrame#sidebar {
    background-color: #FFFFFF;
    border: none;
    border-right: 1px solid #E5E7EB;
}

QLabel#brandName {
    color: #111827;
    font-size: 17pt;
    font-weight: 700;
}

QLabel#brandTagline {
    color: #6B7280;
    font-size: 8pt;
}

QPushButton#navButton {
    text-align: left;
    padding: 9px 12px;
    border: none;
    border-radius: 8px;
    outline: none;
    background-color: transparent;
    color: #374151;
    font-size: 10pt;
}

QPushButton#navButton:hover {
    background-color: #F0FDF4;
    color: #15803D;
}

/* Keyboard focus on a button that is not selected (Tab key). */
QPushButton#navButton:focus:!checked:!hover {
    background-color: #F3F4F6;
}

/* The selected page: green button with white text and icon. */
QPushButton#navButton:checked {
    background-color: #16A34A;
    color: #FFFFFF;
    font-weight: 600;
}

QLabel#sidebarFooter {
    color: #9CA3AF;
    font-size: 8pt;
    padding-left: 6px;
}

/* ---- Page header ---- */
QLabel#pageTitle {
    color: #111827;
    font-size: 19pt;
    font-weight: 700;
}

QLabel#pageSubtitle {
    color: #6B7280;
    font-size: 10pt;
}

/* ---- Cards: white boxes with rounded corners ---- */
QFrame#card {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    border-radius: 12px;
}

/* ---- "Coming in Milestone N" card ---- */
QLabel#emptyIcon {
    background-color: #16A34A;
    border-radius: 18px;
}

QLabel#emptyTitle {
    color: #111827;
    font-size: 13pt;
    font-weight: 600;
}

QLabel#emptyText {
    color: #6B7280;
    font-size: 10pt;
}

/* =====================================================================
   Milestone 3: Transactions page and form
   ===================================================================== */

/* ---- Buttons ---- */
QPushButton#primaryButton {
    background-color: #16A34A;
    color: #FFFFFF;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #15803D;
}

QPushButton#secondaryButton {
    background-color: #FFFFFF;
    color: #374151;
    border: 1px solid #D1D5DB;
    border-radius: 8px;
    padding: 8px 14px;
}

QPushButton#secondaryButton:hover {
    background-color: #F9FAFB;
}

QPushButton#secondaryButton:disabled {
    color: #9CA3AF;
    border-color: #E5E7EB;
}

QPushButton#dangerButton {
    background-color: #FFFFFF;
    color: #DC2626;
    border: 1px solid #FCA5A5;
    border-radius: 8px;
    padding: 8px 14px;
}

QPushButton#dangerButton:hover {
    background-color: #FEF2F2;
}

QPushButton#dangerButton:disabled {
    color: #FCA5A5;
    border-color: #FEE2E2;
}

/* ---- Text boxes, drop-down lists and date fields ---- */
QLineEdit,
QComboBox,
QDateEdit {
    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 6px 8px;
}

QLineEdit:focus,
QComboBox:focus,
QDateEdit:focus {
    border-color: #16A34A;
}

/* Editable lists and date fields contain their own text box; it must
   not draw a second border inside the outer one. */
QComboBox QLineEdit,
QDateEdit QLineEdit {
    border: none;
    padding: 0px;
    background: transparent;
}

QComboBox::drop-down,
QDateEdit::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow,
QDateEdit::down-arrow {
    image: url(:/icons/chevron_down.svg);
    width: 12px;
    height: 12px;
}

/* ---- Transactions table ---- */
QTableWidget#transactionTable {
    background-color: #FFFFFF;
    alternate-background-color: #F9FAFB;
    border: none;
    selection-background-color: #DCFCE7;
    selection-color: #111827;
}

QTableWidget#transactionTable::item {
    padding: 6px;
}

QHeaderView::section {
    background-color: #FFFFFF;
    color: #6B7280;
    border: none;
    border-bottom: 1px solid #E5E7EB;
    padding: 8px 6px;
    font-weight: 600;
}

/* ---- Messages ---- */
QLabel#successBanner {
    background-color: #DCFCE7;
    color: #166534;
    border: 1px solid #BBF7D0;
    border-radius: 8px;
    padding: 8px 12px;
}

QLabel#formError {
    color: #DC2626;
}

QLabel#amountPreview,
QLabel#mutedText {
    color: #6B7280;
}

/* ---- The Add / Edit Transaction form ---- */
QDialog {
    background-color: #FFFFFF;
}

QLabel#dialogTitle {
    color: #111827;
    font-size: 14pt;
    font-weight: 700;
}
