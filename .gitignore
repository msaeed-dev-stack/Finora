# Finora .gitignore
# Project type: C++17 + Qt 6 Widgets + CMake, developed on Windows (MinGW + Ninja).
# Lines starting with # are comments. A trailing / means "a folder".

# ---- Build folders (CMake + Ninja output) ----
build/
build-*/
out/
cmake-build-*/

# ---- CMake files, in case CMake is ever run outside a build folder ----
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
_deps/
compile_commands.json
# Personal presets stay local; the shared CMakePresets.json IS committed.
CMakeUserPresets.json

# ---- Files generated by Qt tools (moc, rcc, uic) ----
*_autogen/
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qm
.qmake.stash
.qtc_clangd/

# ---- Qt Creator per-user settings ----
CMakeLists.txt.user*
*.pro.user*
*.qbs.user*

# ---- Compiled objects, libraries and programs ----
*.o
*.obj
*.a
*.lib
*.dll
*.exe
*.pdb
*.ilk
*.exp

# ---- Exception: the vendored, signature-verified libsodium files ARE kept ----
# (see third_party/libsodium-1.0.22/VERIFICATION.md)
!third_party/**/*.dll
!third_party/**/*.a

# ---- Packaged Windows builds (windeployqt output and zip files) ----
dist/
deploy/
*.zip

# ---- Local Finora data: SQLite database, journal files, backups ----
# Real user data must never be uploaded to GitHub.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.bak

# ---- Editors and IDEs ----
.vs/
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*~

# ---- Claude Code personal permission settings ----
.claude/settings.local.json

# ---- Windows system files ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ---- Microsoft Office lock files (created while a .docx is open in Word) ----
~$*
